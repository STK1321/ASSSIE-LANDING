---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Capabilities from "@/components/sections/Capabilities.astro";
import Direction from "@/components/sections/Direction.astro";
import Proof from "@/components/sections/Proof.astro";
import Process from "@/components/sections/Process.astro";
import Contact from "@/components/sections/Contact.astro";
import { buildOrganizationSchema, buildServiceSchema, buildWebSiteSchema } from "@/lib/seo/schemas";

const jsonLd = [buildOrganizationSchema(), buildWebSiteSchema(), ...buildServiceSchema()];
---
<BaseLayout
  title="ASSSIE | Herramientas para el trabajo real"
  description="Software propio y trabajo a medida para el comercio que cobra por QR y la empresa chica que vive en tres Excel. Código abierto cuando se publique, sin cuenta y sin anuncios."
  jsonLd={jsonLd}
>
  <Hero />
  <Capabilities />
  <Direction />
  <Proof />
  <Process />
  <Contact />
</BaseLayout>
