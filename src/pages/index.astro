---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/sections/Hero.astro";
import Capabilities from "@/components/sections/Capabilities.astro";
import Direction from "@/components/sections/Direction.astro";
import Proof from "@/components/sections/Proof.astro";
import Process from "@/components/sections/Process.astro";
import Contact from "@/components/sections/Contact.astro";
import { faq } from "@/content/faq";
import { buildOrganizationSchema, buildProfessionalServiceSchema, buildFaqSchema } from "@/lib/seo/schemas";

const jsonLd = [buildOrganizationSchema(), buildProfessionalServiceSchema(), buildFaqSchema(faq)];
---
<BaseLayout
  title="ASSSIE | Automatización, IA y Marketing Digital para Empresas"
  description="Agencia de automatización, datos e IA para PYMES en crecimiento. Marketing digital medible, desarrollo a medida y optimización de procesos en Latam."
  jsonLd={jsonLd}
>
  <Hero />
  <Capabilities />
  <Direction />
  <Proof />
  <Process />
  <Contact />
</BaseLayout>
