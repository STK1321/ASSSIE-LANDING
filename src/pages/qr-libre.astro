---
import ProductLayout from "@/layouts/ProductLayout.astro";
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import FAQItem from "@/components/molecules/FAQItem.astro";
import { qrlibre } from "@/content/qrlibre";
import { site } from "@/content/site";
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildSoftwareApplicationSchema
} from "@/lib/seo/schemas";

const canonical = `${site.url}/qr-libre`;
const whatsappHref = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
const intro =
  "QR Libre es una app de Android para el comerciante que cobra por QR y no puede revisar el teléfono en medio de la atención. Hay una versión de prueba para instalar a mano. Esto es lo que hace hoy, lo que no hace y en qué va el proyecto.";
const jsonLd = [
  buildSoftwareApplicationSchema(),
  buildFaqSchema(qrlibre.faq),
  buildBreadcrumbSchema("/qr-libre", qrlibre.name)
];
---
<ProductLayout
  title={`${qrlibre.name} | ${qrlibre.tagline}`}
  description="QR Libre es una app de Android en construcción que va a avisar en voz alta cuando entre un pago por QR. No confirma pagos, no se conecta a tu banco y no reemplaza el comprobante."
  canonical={canonical}
  jsonLd={jsonLd}
>
  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="reveal max-w-4xl space-y-7">
        <div class="flex flex-wrap items-center gap-3">
          <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">{qrlibre.name}</p>
          <span class="inline-flex items-center gap-2 rounded-full bg-card px-3 py-1 text-xs font-medium text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-lemon" aria-hidden="true"></span>
            {qrlibre.status}
          </span>
        </div>
        <h1 class="font-display text-[clamp(2.5rem,7vw,5rem)] font-semibold leading-[0.96] tracking-[-0.03em] text-text">
          {qrlibre.tagline}
        </h1>
        <p class="max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{intro}</p>
        <p class="text-sm font-medium text-text">Un proyecto de {site.name}</p>
      </div>
    </div>
  </section>

  <section id="alcance" class="py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="reveal">
        <SectionHeading
          eyebrow="Alcance"
          title="Qué hace y qué no hace"
          subtitle="Sin letra pequeña: lo que la app promete y lo que deja por fuera. Los límites importan tanto como las funciones."
        />
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted">
          QR Libre va a escuchar los avisos de pago que ya llegan al teléfono, de las apps que tú actives, y los va a decir en voz alta. No va a necesitar cuenta, no va a pedir permisos que no use y no se va a conectar a tu banco. Si el aviso no llega, la app no va a inventar nada: se va a quedar callada.
        </p>
      </div>
      <div class="reveal-stagger mt-12 grid gap-6 md:grid-cols-2">
        {[
          { kind: "does", title: "Qué hace", items: qrlibre.what },
          { kind: "doesNot", title: "Qué no hace", items: qrlibre.notWhat }
        ].map((column, index) => (
          <div class="flex h-full flex-col rounded-card bg-card p-7 sm:p-8" style={`--stagger: ${index};`}>
            <h3 class="font-display text-xl font-semibold leading-snug text-text">{column.title}</h3>
            <ul class="mt-5 space-y-3 text-sm leading-relaxed text-muted">
              {column.items.map((item) => (
                <li class="flex gap-3">
                  {column.kind === "does" ? (
                    <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-lemon" />
                  ) : (
                    <span class="mt-2.5 block h-px w-4 shrink-0 bg-muted/40" aria-hidden="true"></span>
                  )}
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-card py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="reveal">
        <SectionHeading
          eyebrow="El recorrido"
          title="Cómo funciona"
          subtitle="Tres pasos, de la instalación al aviso en voz alta. Sin configuración técnica ni equipos nuevos."
        />
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted">
          El recorrido tiene tres pasos y ninguno requiere configurar nada raro. Instalas la app, le das permiso para leer notificaciones y eliges de qué apps. Desde ahí, cada aviso de pago que llegue se convierte en una frase corta que se escucha desde el otro lado del mostrador.
        </p>
      </div>
      <ol role="list" class="reveal-stagger mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
        {qrlibre.how.map((step, index) => (
          <li class="flex h-full flex-col border-t border-divider pt-6" style={`--stagger: ${index};`}>
            <span class="text-xs font-medium text-muted">Paso {index + 1}</span>
            <h3 class="mt-4 font-display text-xl font-semibold leading-snug text-text">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.detail}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="reveal">
        <SectionHeading
          eyebrow="Dónde va el proyecto"
          title="Estado"
          subtitle="Qué existe hoy y cuándo se actualizó esta página."
        />
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted">
          QR Libre está en construcción y la fecha de abajo dice cuándo se actualizó esta página por última vez. Ya hay una versión de prueba y el código es público. Lo que todavía no existe son las reglas que reconocen un pago real.
        </p>
      </div>
      <div class="reveal-stagger mt-12">
        <div class="rounded-card bg-card p-7 sm:p-10" style="--stagger: 0;">
          <dl class="grid gap-8 sm:grid-cols-2">
            <div>
              <dt class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Estado</dt>
              <dd class="mt-2 text-base font-semibold text-text">{qrlibre.status}</dd>
            </div>
            <div>
              <dt class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Última actualización</dt>
              <dd class="mt-2 text-base font-semibold text-text">{qrlibre.updated}</dd>
            </div>
          </dl>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <Button href={qrlibre.download} target="_blank" rel="noopener">Descargar la versión de prueba</Button>
            <p class="max-w-md text-sm leading-relaxed text-muted">{qrlibre.downloadNote}</p>
          </div>
          <div class="mt-8 border-t border-divider pt-8">
            <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Código</p>
            {qrlibre.repo ? (
              <div class="mt-3 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                <p class="max-w-xl text-sm leading-relaxed text-muted">El código está abierto: puedes leerlo, copiarlo y adaptarlo.</p>
                <Button href={qrlibre.repo} target="_blank" rel="noopener" class="shrink-0">Ver el repositorio</Button>
              </div>
            ) : (
              <div class="mt-3 space-y-3">
                <p class="text-sm leading-relaxed text-muted">El repositorio todavía no está público. Cuando abramos el código, el enlace va a estar aquí.</p>
                <Button as="button" type="button" variant="ghost" disabled aria-disabled="true" class="cursor-not-allowed opacity-50">
                  Repositorio
                </Button>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-4xl px-6">
      <div class="reveal">
        <SectionHeading eyebrow="Preguntas" title="Preguntas frecuentes" />
        <p class="mt-6 max-w-3xl text-base leading-relaxed text-muted">
          Estas son las preguntas que más nos hacen los comerciantes, respondidas sin adornos. Si te queda una duda que no está aquí, escríbenos por WhatsApp: la respondemos y, si se repite, la agregamos a esta lista.
        </p>
      </div>
      <div class="reveal-stagger mt-12 grid gap-4">
        {qrlibre.faq.map((item, index) => (
          <div style={`--stagger: ${index};`}>
            <FAQItem item={item} />
          </div>
        ))}
      </div>
      <p class="mt-10 text-sm text-muted">
        Si tu pregunta no está aquí,
        <a class="inline-flex items-center gap-2 font-semibold text-lemon hover:underline" href={whatsappHref} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="h-4 w-4" />
          escríbenos por WhatsApp
        </a>.
      </p>
    </div>
  </section>

  <section class="pb-20 pt-4 sm:pb-24">
    <div class="mx-auto max-w-6xl px-6">
      <a href="/" class="text-sm font-medium text-muted transition-colors duration-200 hover:text-lemon">Un proyecto de {site.name}</a>
    </div>
  </section>
</ProductLayout>
