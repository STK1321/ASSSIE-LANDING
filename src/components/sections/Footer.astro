---
import { site } from "@/content/site";

const here = Astro.url.pathname;
const link = (href: string) => (here === "/" ? href : `/${href}`);

const nav = [
  { label: "Qué hacemos", href: "#que-hacemos" },
  { label: "Herramientas", href: "#herramientas" },
  { label: "La prueba", href: "#prueba" },
  { label: "Cómo trabajamos", href: "#proceso" },
  { label: "Contacto", href: "#contacto" },
];

const whatsappHref = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
---
<footer class="border-t border-divider bg-page">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr] reveal">
      <div class="space-y-3">
        <p class="font-display text-lg font-semibold text-text">{site.name}</p>
        <p class="text-xs text-muted">{site.slogan}</p>
        <p class="text-xs text-muted">(c) {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      </div>
      <div class="space-y-3">
        <p class="text-xs font-medium text-muted">Secciones</p>
        <div class="flex flex-col gap-2 text-sm text-muted">
          {nav.map((item) => (
            <a href={link(item.href)} class="transition-colors duration-200 hover:text-text">{item.label}</a>
          ))}
        </div>
      </div>
      <div class="space-y-3">
        <p class="text-xs font-medium text-muted">Contacto</p>
        <div class="flex flex-col gap-2 text-sm text-muted">
          <a href={whatsappHref} target="_blank" rel="noopener" class="font-medium text-text transition-colors duration-200 hover:text-lemon">{site.whatsapp}</a>
          <span>{site.address.locality}, {site.address.region}</span>
        </div>
        <div class="flex flex-col gap-2 text-xs text-muted">
          <a href="/privacidad" class="transition-colors duration-200 hover:text-text">Política de privacidad</a>
          <a href="/qr-libre/privacidad" class="transition-colors duration-200 hover:text-text">Privacidad de QR Libre</a>
          {site.github && (
            <a href={site.github} target="_blank" rel="noopener" class="transition-colors duration-200 hover:text-text">GitHub</a>
          )}
        </div>
      </div>
    </div>
  </div>
</footer>
