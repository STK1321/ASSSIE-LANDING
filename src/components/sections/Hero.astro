---
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import { site } from "@/content/site";

const whatsappLink = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
const facts = [
  "Código abierto: lo puedes leer",
  "Sin cuenta y sin anuncios",
  "Te entregamos el código y la documentación"
];
---
<section id="top" class="py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-5xl space-y-8">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-muted">Bienes Públicos de ASSSIE</p>
      <h1 class="font-display text-[clamp(2.5rem,7vw,5rem)] font-semibold leading-[0.96] tracking-[-0.03em] text-text">
        Herramientas para el trabajo real.
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        Construimos software para el comercio que cobra por QR y para la empresa chica que vive en tres Excels. Vamos a publicar el código abierto, para que cualquiera pueda leerlo y usarlo. Gratis en la superficie; a medida cuando
        tu operación no cabe.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <Button variant="primary" size="lg" href="#herramientas">Ver las herramientas</Button>
        <Button variant="ghost" size="lg" href={whatsappLink} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="h-4 w-4" />
          Hablemos por WhatsApp
        </Button>
      </div>
      <ul class="flex flex-col gap-2 pt-2 text-sm text-muted sm:flex-row sm:flex-wrap sm:items-center sm:gap-0">
        {facts.map((fact, index) => (
          <li class="flex items-center">
            {index > 0 ? <span class="mx-4 hidden h-3.5 w-px bg-divider sm:block" aria-hidden="true"></span> : null}
            <span>{fact}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
