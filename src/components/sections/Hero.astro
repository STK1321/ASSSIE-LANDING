---
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import { site } from "@/content/site";

const whatsappLink = `https://wa.me/${site.whatsapp.replace(/\D/g, "")}`;
const facts = [
  "Código abierto cuando se publique",
  "Sin cuenta y sin anuncios",
  "Te entregamos el código y la documentación"
];
---
<section id="top" class="bg-hero">
  <div class="mx-auto max-w-3xl px-6 pb-16 pt-28">
    <div class="reveal space-y-6">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">Bienes Públicos de ASSSIE</p>
      <h1 class="font-display text-4xl font-semibold text-ink sm:text-6xl">
        Herramientas para el trabajo real.
      </h1>
      <p class="text-lg text-slate">
        Construimos software para el comercio que cobra por QR y para la empresa chica que vive en tres Excels. Vamos a publicar el código abierto, para que cualquiera pueda leerlo y usarlo. Gratis en la superficie; a medida cuando
        tu operación no cabe.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button variant="primary" href="#herramientas">Ver las herramientas</Button>
        <Button variant="ghost" href={whatsappLink} target="_blank" rel="noopener">
          <Icon name="whatsapp" class="h-4 w-4" />
          Hablemos por WhatsApp
        </Button>
      </div>
      <ul class="grid gap-2 text-sm text-slate">
        {facts.map((fact) => (
          <li class="flex items-center gap-2">
            <Icon name="check" class="h-4 w-4 shrink-0 text-accent" />
            <span>{fact}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
