---
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import { site } from "@/content/site";

const whatsappDigits = site.whatsapp.replace(/\D/g, "");
const whatsappLink = `https://wa.me/${whatsappDigits}`;
const baseMessage = "Hola, quiero contarles mi objetivo.";
const waHref = (text: string) => `${whatsappLink}?text=${encodeURIComponent(text)}`;
const fallbackHref = waHref(baseMessage);
---
<section id="contacto" class="py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_1fr]">
      <div class="space-y-6 reveal">
        <SectionHeading
          eyebrow="Contacto"
          title="Hablemos de tu objetivo"
          subtitle="Cuéntanos tu objetivo. El formulario abre WhatsApp con el mensaje ya escrito, para que lo revises y lo envíes tú."
        />
        <div class="rounded-3xl border border-slate/10 bg-white p-6 shadow-card">
          <form id="lead-form" class="space-y-4" novalidate>
            <div>
              <label class="text-sm font-semibold text-ink" for="name">Nombre</label>
              <input class="mt-2 w-full rounded-xl border border-slate/20 bg-white px-4 py-3 text-sm" id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label class="text-sm font-semibold text-ink" for="whatsapp">Tu WhatsApp (opcional)</label>
              <input class="mt-2 w-full rounded-xl border border-slate/20 bg-white px-4 py-3 text-sm" id="whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" />
            </div>
            <div>
              <label class="text-sm font-semibold text-ink" for="goal">¿Qué problema quieres resolver?</label>
              <textarea class="mt-2 w-full rounded-xl border border-slate/20 bg-white px-4 py-3 text-sm" id="goal" name="goal" rows="3" required></textarea>
            </div>
            <div>
              <label class="text-sm font-semibold text-ink" for="company">Empresa (opcional)</label>
              <input class="mt-2 w-full rounded-xl border border-slate/20 bg-white px-4 py-3 text-sm" id="company" name="company" type="text" autocomplete="organization" />
            </div>
            <div>
              <label class="text-sm font-semibold text-ink" for="companySize">Tamaño aproximado de la empresa (opcional)</label>
              <select class="mt-2 w-full rounded-xl border border-slate/20 bg-white px-4 py-3 text-sm" id="companySize" name="companySize">
                <option value="">Selecciona un rango</option>
                <option value="1-10">1-10</option>
                <option value="11-50">11-50</option>
                <option value="51-200">51-200</option>
                <option value="201-1000">201-1000</option>
                <option value="1000+">1000+</option>
              </select>
            </div>
            <div class="flex flex-wrap gap-3 pt-2">
              <Button as="button" type="button" variant="primary" data-submit>
                Enviar por WhatsApp
              </Button>
            </div>
            <p class="text-xs text-slate" data-submit-status aria-live="polite" role="status"></p>
            <noscript>
              <Button href={fallbackHref} target="_blank" rel="noopener">
                <Icon name="whatsapp" class="h-4 w-4" />
                Escribir por WhatsApp
              </Button>
            </noscript>
            <p class="text-xs text-slate">
              Se abre WhatsApp con tu mensaje ya escrito. Lo revisas y lo envías tú.
            </p>
          </form>
        </div>
      </div>
      <div class="space-y-4 reveal" style="--reveal-delay: 120ms;">
        <div class="rounded-3xl border border-slate/10 bg-white p-6 shadow-card">
          <h3 class="text-lg font-semibold text-ink">Contacto directo</h3>
          <p class="mt-2 text-sm text-slate">
            WhatsApp:
            <a class="font-semibold text-accent hover:underline" href={whatsappLink} target="_blank" rel="noopener">{site.whatsapp}</a>
          </p>
          <p class="mt-1 text-sm text-slate">Zona: {site.address.locality}, {site.address.region}</p>
        </div>
        <div class="rounded-3xl border border-slate/10 bg-white p-6 shadow-card">
          <h3 class="text-lg font-semibold text-ink">Lo que incluye la primera conversación</h3>
          <ul class="mt-3 space-y-2 text-sm text-slate">
            <li class="flex gap-2">
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4 shrink-0 text-accent"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Revisión de objetivos y procesos actuales.</span>
            </li>
            <li class="flex gap-2">
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4 shrink-0 text-accent"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Propuesta inicial de automatización y data.</span>
            </li>
            <li class="flex gap-2">
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4 shrink-0 text-accent"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Estimación de tiempos y próximos pasos.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ whatsappDigits, baseMessage }}>
    const form = document.getElementById("lead-form");
    const status = form?.querySelector("[data-submit-status]");
    const submitButton = form?.querySelector("[data-submit]");

    const statusClasses = {
      loading: "text-slate",
      success: "text-emerald-600",
      error: "text-rose-600"
    };

    const waHref = (text) => `https://wa.me/${whatsappDigits}?text=${encodeURIComponent(text)}`;

    const buildMessage = (values) => {
      const name = String(values.name || "").trim();
      const goal = String(values.goal || "").trim();
      const company = String(values.company || "").trim();
      const companySize = String(values.companySize || "").trim();
      const whatsapp = String(values.whatsapp || "").trim();

      let message;
      if (name && goal) {
        message = `Hola, soy ${name}. ${goal}`;
      } else if (name) {
        message = `Hola, soy ${name}.`;
      } else if (goal) {
        message = `Hola, quiero contarles: ${goal}`;
      } else {
        message = baseMessage;
      }

      if (company && companySize) {
        message += `\n\nEmpresa: ${company}. Tamaño: ${companySize} personas.`;
      } else if (company) {
        message += `\n\nEmpresa: ${company}.`;
      } else if (companySize) {
        message += `\n\nTamaño de la empresa: ${companySize} personas.`;
      }
      if (whatsapp) {
        message += `\n\nMi WhatsApp para responderme: ${whatsapp}.`;
      }
      return message;
    };

    const setStatus = (state, message, linkHref) => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.classList.remove("text-slate", "text-emerald-600", "text-rose-600");
      status.classList.add(statusClasses[state] ?? "text-slate");

      if (linkHref) {
        const link = document.createElement("a");
        link.href = linkHref;
        link.target = "_blank";
        link.rel = "noopener";
        link.className = "font-semibold text-accent hover:underline";
        link.textContent = linkHref;
        status.append(" ", link);
      }
    };

    // The form has no submit control. With more than one text field, Enter does not
    // implicitly submit. This guard only catches programmatic submits when JS is on.
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
    });

    submitButton?.addEventListener("click", () => {
      if (!form || !submitButton) return;

      const values = Object.fromEntries(new FormData(form).entries());
      const name = String(values.name || "").trim();
      const goal = String(values.goal || "").trim();
      const href = waHref(buildMessage(values));

      const missing = [];
      if (!name) missing.push("tu nombre");
      if (!goal) missing.push("contar qué necesitas");

      if (missing.length) {
        const message =
          missing.length === 2
            ? "Falta tu nombre y contar qué necesitas."
            : `Falta ${missing[0]}.`;
        setStatus("error", message, href);
        const field = document.getElementById(!name ? "name" : "goal");
        if (field instanceof HTMLElement) field.focus();
        return;
      }

      submitButton.setAttribute("disabled", "true");
      setStatus("loading", "Abriendo WhatsApp...");

      try {
        window.open(href, "_blank", "noopener");
        form.reset();
        setStatus("success", "Abrimos WhatsApp con tu mensaje. Revísalo y envíalo ahí.", href);
      } catch {
        setStatus("error", "No pudimos abrir WhatsApp. Abre este enlace tú:", href);
      } finally {
        submitButton.removeAttribute("disabled");
      }
    });
  </script>
</section>
