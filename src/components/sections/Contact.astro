---
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import { site } from "@/content/site";

const whatsappDigits = site.whatsapp.replace(/\D/g, "");
const whatsappLink = `https://wa.me/${whatsappDigits}`;
const baseMessage = "Hola, quiero contarles mi objetivo.";
const waHref = (text: string) => `${whatsappLink}?text=${encodeURIComponent(text)}`;
const fallbackHref = waHref(baseMessage);
const fieldClass =
  "mt-2 w-full rounded-medium border border-divider bg-page px-4 py-3 text-sm text-text placeholder:text-muted transition-colors duration-200 focus:border-lemon";
---
<section id="contacto" class="py-24 sm:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
      <div class="space-y-8 reveal">
        <SectionHeading
          eyebrow="Contacto"
          title="Hablemos de tu objetivo"
          subtitle="Cuéntanos tu objetivo. El formulario abre WhatsApp con el mensaje ya escrito, para que lo revises y lo envíes tú."
        />
        <p class="max-w-2xl text-base leading-relaxed text-muted">
          Escríbenos qué te está costando hoy: una operación que vive en Excel, un proceso que depende de una persona, números que no cuadran. Leemos el mensaje, miramos si hay algo que construir y te respondemos con una idea concreta, no con un formulario de ventas.
        </p>
        <div class="rounded-card bg-card p-6 sm:p-8">
          <form id="lead-form" class="space-y-5" novalidate>
            <div>
              <label class="text-sm font-medium text-text" for="name">Nombre</label>
              <input class={fieldClass} id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label class="text-sm font-medium text-text" for="whatsapp">Tu WhatsApp (opcional)</label>
              <input class={fieldClass} id="whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" />
            </div>
            <div>
              <label class="text-sm font-medium text-text" for="goal">¿Qué problema quieres resolver?</label>
              <textarea class={fieldClass} id="goal" name="goal" rows="3" required></textarea>
            </div>
            <div>
              <label class="text-sm font-medium text-text" for="company">Empresa (opcional)</label>
              <input class={fieldClass} id="company" name="company" type="text" autocomplete="organization" />
            </div>
            <div>
              <label class="text-sm font-medium text-text" for="companySize">Tamaño aproximado de la empresa (opcional)</label>
              <select class={fieldClass} id="companySize" name="companySize">
                <option value="">Selecciona un rango</option>
                <option value="1-10">1-10</option>
                <option value="11-50">11-50</option>
                <option value="51-200">51-200</option>
                <option value="201-1000">201-1000</option>
                <option value="1000+">1000+</option>
              </select>
            </div>
            <div class="flex flex-wrap gap-3 pt-2">
              <Button as="button" type="button" variant="primary" data-submit>
                Enviar por WhatsApp
              </Button>
            </div>
            <p class="text-xs text-muted" data-submit-status aria-live="polite" role="status"></p>
            <noscript>
              <Button href={fallbackHref} target="_blank" rel="noopener">
                <Icon name="whatsapp" class="h-4 w-4" />
                Escribir por WhatsApp
              </Button>
            </noscript>
            <p class="text-xs text-muted">
              Se abre WhatsApp con tu mensaje ya escrito. Lo revisas y lo envías tú.
            </p>
            <p class="text-xs text-muted">
              <a class="font-medium text-lemon hover:underline" href="/privacidad">Cómo tratamos tus datos</a>
            </p>
          </form>
        </div>
      </div>
      <div class="space-y-4 reveal" style="--reveal-delay: 120ms;">
        <div class="rounded-card bg-card p-6">
          <h3 class="text-lg font-semibold text-text">Contacto directo</h3>
          <p class="mt-2 text-sm text-muted">
            WhatsApp:
            <a class="font-medium text-lemon hover:underline" href={whatsappLink} target="_blank" rel="noopener">{site.whatsapp}</a>
          </p>
          <p class="mt-1 text-sm text-muted">Zona: {site.address.locality}, {site.address.region}</p>
        </div>
        <div class="rounded-card bg-card p-6">
          <h3 class="text-lg font-semibold text-text">Lo que incluye la primera conversación</h3>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 shrink-0 text-green" />
              <span>Revisión de objetivos y procesos actuales.</span>
            </li>
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 shrink-0 text-green" />
              <span>Propuesta inicial de automatización y data.</span>
            </li>
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 shrink-0 text-green" />
              <span>Estimación de tiempos y próximos pasos.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ whatsappDigits, baseMessage }}>
    const form = document.getElementById("lead-form");
    const status = form?.querySelector("[data-submit-status]");
    const submitButton = form?.querySelector("[data-submit]");

    const statusClasses = {
      loading: "text-muted",
      success: "text-green",
      error: "text-danger"
    };

    const waHref = (text) => `https://wa.me/${whatsappDigits}?text=${encodeURIComponent(text)}`;

    const buildMessage = (values) => {
      const name = String(values.name || "").trim();
      const goal = String(values.goal || "").trim();
      const company = String(values.company || "").trim();
      const companySize = String(values.companySize || "").trim();
      const whatsapp = String(values.whatsapp || "").trim();

      let message;
      if (name && goal) {
        message = `Hola, soy ${name}. ${goal}`;
      } else if (name) {
        message = `Hola, soy ${name}.`;
      } else if (goal) {
        message = `Hola, quiero contarles: ${goal}`;
      } else {
        message = baseMessage;
      }

      if (company && companySize) {
        message += `\n\nEmpresa: ${company}. Tamaño: ${companySize} personas.`;
      } else if (company) {
        message += `\n\nEmpresa: ${company}.`;
      } else if (companySize) {
        message += `\n\nTamaño de la empresa: ${companySize} personas.`;
      }
      if (whatsapp) {
        message += `\n\nMi WhatsApp para responderme: ${whatsapp}.`;
      }
      return message;
    };

    const setStatus = (state, message, linkHref) => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
      status.classList.remove("text-muted", "text-green", "text-danger");
      status.classList.add(statusClasses[state] ?? "text-muted");

      if (linkHref) {
        const link = document.createElement("a");
        link.href = linkHref;
        link.target = "_blank";
        link.rel = "noopener";
        link.className = "font-medium text-lemon hover:underline";
        link.textContent = linkHref;
        status.append(" ", link);
      }
    };

    // The form has no submit control. With more than one text field, Enter does not
    // implicitly submit. This guard only catches programmatic submits when JS is on.
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
    });

    const submitToWhatsApp = () => {
      if (!form || !submitButton) return;

      const values = Object.fromEntries(new FormData(form).entries());
      const name = String(values.name || "").trim();
      const goal = String(values.goal || "").trim();
      const href = waHref(buildMessage(values));

      const missing = [];
      if (!name) missing.push("tu nombre");
      if (!goal) missing.push("contar qué necesitas");

      if (missing.length) {
        const message =
          missing.length === 2
            ? "Falta tu nombre y contar qué necesitas."
            : `Falta ${missing[0]}.`;
        setStatus("error", message, href);
        const field = document.getElementById(!name ? "name" : "goal");
        if (field instanceof HTMLElement) field.focus();
        return;
      }

      submitButton.setAttribute("disabled", "true");
      setStatus("loading", "Abriendo WhatsApp...");

      try {
        window.open(href, "_blank", "noopener");
        form.reset();
        setStatus("success", "Abrimos WhatsApp con tu mensaje. Revísalo y envíalo ahí.", href);
      } catch {
        setStatus("error", "No pudimos abrir WhatsApp. Abre este enlace tú:", href);
      } finally {
        submitButton.removeAttribute("disabled");
      }
    };

    submitButton?.addEventListener("click", submitToWhatsApp);

    // Enter in a single-line field does the same as the button. The textarea keeps
    // Enter for new lines, and the select and button keep their native behavior.
    form?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.isComposing || event.repeat) return;
      if (!(event.target instanceof HTMLInputElement)) return;
      event.preventDefault();
      submitToWhatsApp();
    });
  </script>
</section>
