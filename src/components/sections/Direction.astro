---
import Button from "@/components/atoms/Button.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import { direction } from "@/content/direction";
---
<section id="herramientas" class="py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal max-w-3xl space-y-6">
      <SectionHeading eyebrow="Hacia dónde vamos" title="Las herramientas" />
      <p class="text-lg leading-relaxed text-muted">{direction.intro}</p>
    </div>
  </div>

  <div class="mt-16 bg-card py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-6">
      <ol role="list" class="reveal-stagger grid gap-10 md:grid-cols-3 md:gap-8">
        {direction.steps.map((step, index) => (
          <li class="flex flex-col border-t border-divider pt-6" style={`--stagger: ${index};`}>
            <span class="font-mono text-xs tracking-[0.2em] text-muted" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="mt-4 font-display text-xl font-semibold text-text">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{step.detail}</p>
          </li>
        ))}
      </ol>

      <div class="reveal mt-14 max-w-3xl border-t border-divider pt-8">
        <p class="text-base leading-relaxed text-text sm:text-lg">{direction.closing}</p>
      </div>
      <div class="reveal mt-8">
        <Button variant="primary" href="/qr-libre">Conocer QR Libre</Button>
      </div>
    </div>
  </div>
</section>
