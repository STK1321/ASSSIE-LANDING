---
import Button from "@/components/atoms/Button.astro";
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import { direction } from "@/content/direction";
---
<section id="herramientas" class="bg-surface py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal">
      <SectionHeading eyebrow="Hacia dónde vamos" title="Las herramientas" />
      <p class="mt-6 max-w-3xl text-lg text-slate">{direction.intro}</p>
    </div>

    <ol class="reveal-stagger mt-10 grid gap-6 md:grid-cols-3">
      {direction.steps.map((step, index) => (
        <li class="flex h-full flex-col rounded-3xl border border-slate/10 bg-white p-6 shadow-card" style={`--stagger: ${index};`}>
          <span class="block h-px w-10 bg-accent/50" aria-hidden="true"></span>
          <h3 class="mt-4 font-display text-xl font-semibold text-ink">{step.title}</h3>
          <p class="mt-3 text-sm text-slate">{step.detail}</p>
        </li>
      ))}
    </ol>

    <div class="reveal mt-10 space-y-6">
      <div class="rounded-3xl border border-accent/30 bg-white p-6 sm:p-8">
        <p class="max-w-3xl text-base text-ink sm:text-lg">{direction.closing}</p>
      </div>
      <Button variant="primary" href="/qr-libre">Conocer QR Libre</Button>
    </div>
  </div>
</section>
