---
import SectionHeading from "@/components/molecules/SectionHeading.astro";
import ProcessStep from "@/components/molecules/ProcessStep.astro";
import { processSteps } from "@/content/process";
---
<section id="proceso" class="py-14 sm:py-16">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal">
      <SectionHeading
        title="Cómo trabajamos"
        subtitle="Casi ningún proyecto se cae por la tecnología: se cae porque nadie entendió cómo trabaja el negocio. Por eso empezamos mirando tu operación, no escribiendo código. Construimos lo más pequeño que resuelve el problema, lo ponemos a funcionar, y te entregamos el código y la documentación para que no dependas de nosotros."
      />
    </div>
    <div class="reveal-stagger mt-12 grid sm:grid-cols-3 sm:divide-x sm:divide-divider">
      {processSteps.map((step, index) => (
        <div class="border-t border-divider py-8 first:border-t-0 sm:border-t-0 sm:px-8 sm:py-0 sm:first:pl-0 sm:last:pr-0" style={`--stagger: ${index};`}>
          <ProcessStep step={step} />
        </div>
      ))}
    </div>
  </div>
</section>
