---
import type { Proof } from "@/content/proof";

const { item } = Astro.props as { item: Proof };
const headingId = `proof-${item.name
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;
---
<article aria-labelledby={headingId} class="flex h-full flex-col rounded-card bg-card p-7 transition-colors duration-200 ease-out hover:bg-elevated">
  <p class="text-xs font-medium text-muted">{item.sector}</p>
  <h3 id={headingId} class="mt-3 font-display text-2xl font-semibold leading-snug text-text">{item.name}</h3>
  <p class="mt-4 text-base leading-relaxed text-text">{item.detail}</p>
  <p class="mt-3 text-sm leading-relaxed text-muted">{item.outcome}</p>
</article>
