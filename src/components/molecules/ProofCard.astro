---
import type { Proof } from "@/content/proof";

const { item } = Astro.props as { item: Proof };
const headingId = `proof-${item.name
  .toLowerCase()
  .normalize("NFD")
  .replace(/[\u0300-\u036f]/g, "")
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}`;
---
<article aria-labelledby={headingId} class="flex h-full flex-col rounded-3xl border border-slate/10 bg-white p-6 shadow-card">
  <h3 id={headingId} class="font-display text-xl font-semibold text-ink">{item.name}</h3>
  <p class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-accent">{item.sector}</p>
  <p class="mt-3 text-lg text-ink">{item.detail}</p>
  <p class="mt-2 text-sm text-slate">{item.outcome}</p>
</article>
