---
const { step, index } = Astro.props;
---
<div class="flex h-full flex-col rounded-2xl border border-slate/10 bg-white p-5 shadow-card">
  <p class="text-xs font-semibold tracking-[0.2em] text-accent">{String(index + 1).padStart(2, "0")}</p>
  <h3 class="mt-2 text-lg font-semibold text-ink">{step.title}</h3>
  <p class="mt-2 text-sm text-slate">{step.detail}</p>
</div>
