---
import type { Capability } from "@/content/capabilities";

const { capability } = Astro.props as { capability: Capability };
---
<article class="flex h-full flex-col rounded-3xl border border-slate/10 bg-white p-6 shadow-card">
  <h3 class="font-display text-xl font-semibold text-ink">{capability.problem}</h3>
  <p class="mt-3 text-lg text-ink">{capability.offer}</p>
  <p class="mt-2 text-sm text-slate">{capability.detail}</p>
</article>
